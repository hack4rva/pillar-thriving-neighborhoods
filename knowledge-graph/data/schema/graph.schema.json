{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://hack4rva.org/schemas/graph.schema.json",
 "title": "Built Environment Knowledge Graph Schema",
 "description": "Schema for the evidence-backed knowledge graph extracted from the pillar-thriving-built-environment repository. See docs/ontology.md for semantics.",
 "definitions": {
  "nodeType": {
   "type": "string",
   "enum": [
    "Problem",
    "Need",
    "Person",
    "Population",
    "Community",
    "ConstituentGroup",
    "Organization",
    "GovernmentAgency",
    "LegislativeBody",
    "Employer",
    "Nonprofit",
    "Foundation",
    "University",
    "TrainingProvider",
    "Vendor",
    "Investor",
    "Donor",
    "Program",
    "Project",
    "Policy",
    "Legislation",
    "Proposal",
    "Grant",
    "Contract",
    "Fund",
    "Budget",
    "Donation",
    "Investment",
    "TaxIncentive",
    "Service",
    "Credential",
    "JobFamily",
    "GeographicRegion",
    "Outcome",
    "Evidence",
    "Claim",
    "ResearchQuestion",
    "Risk",
    "DecisionPoint",
    "Dataset",
    "UnknownEntity"
   ]
  },
  "edgeType": {
   "type": "string",
   "enum": [
    "AFFECTS",
    "EXPERIENCES_NEED",
    "REPRESENTS",
    "SERVES",
    "EMPLOYS",
    "GOVERNS",
    "REGULATES",
    "FUNDS",
    "DONATES_TO",
    "INVESTS_IN",
    "GRANTS_TO",
    "CONTRACTS_WITH",
    "APPROPRIATES_TO",
    "ADMINISTERS",
    "DISTRIBUTES_TO",
    "PASSES_THROUGH",
    "RESTRICTS",
    "REQUIRES_MATCHING_FUNDS",
    "DELIVERS_SERVICE_TO",
    "TRAINS",
    "CREDENTIALS",
    "PROPOSES",
    "SUPPORTS",
    "OPPOSES",
    "DEPENDS_ON",
    "IMPLEMENTS",
    "EVALUATES",
    "MEASURES",
    "PRODUCES",
    "BENEFITS",
    "FAILS_TO_REACH",
    "HAS_EVIDENCE",
    "SUPPORTED_BY",
    "CONTRADICTED_BY",
    "INFERRED_FROM",
    "CITED_BY",
    "ASSOCIATED_WITH",
    "LOCATED_IN",
    "MANAGES",
    "PUBLISHES",
    "ADDRESSES"
   ]
  },
  "evidenceStatus": {
   "type": "string",
   "enum": [
    "documented",
    "externally_verified",
    "proposed",
    "reported_but_unverified",
    "inferred",
    "hypothetical",
    "disputed",
    "unknown"
   ]
  },
  "financialStatus": {
   "type": "string",
   "enum": [
    "proposed",
    "approved",
    "committed",
    "disbursed",
    "partially_disbursed",
    "completed",
    "canceled",
    "unknown"
   ]
  },
  "confidence": {
   "type": "string",
   "enum": [
    "high",
    "medium",
    "low"
   ]
  },
  "provenance": {
   "type": "object",
   "required": [
    "sourceDoc",
    "sourceLocation"
   ],
   "properties": {
    "sourceDoc": {
     "type": "string",
     "minLength": 1
    },
    "sourceLocation": {
     "type": "string",
     "minLength": 1
    },
    "excerpt": {
     "type": "string"
    },
    "evidenceLogId": {
     "type": "string"
    },
    "claimId": {
     "description": "Evidence record this element was extracted from, when it came from a cited claim in the research corpus. Lets a node or edge be traced to the exact sentence that produced it.",
     "type": "string"
    },
    "sourceTitle": {
     "description": "Title of the primary source the claim cites.",
     "type": "string"
    },
    "url": {
     "description": "Primary source the claim cites. sourceDoc stays the in-repo file so provenance remains file-verifiable; this is the outbound link a reader follows to check the claim against the original.",
     "type": "string"
    },
    "note": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "temporal": {
   "type": "object",
   "properties": {
    "start": {
     "type": [
      "string",
      "null"
     ]
    },
    "end": {
     "type": [
      "string",
      "null"
     ]
    },
    "asOf": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "financial": {
   "type": "object",
   "properties": {
    "amountUSD": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "currency": {
     "type": "string",
     "const": "USD"
    },
    "mechanism": {
     "type": [
      "string",
      "null"
     ]
    },
    "status": {
     "$ref": "#/definitions/financialStatus"
    },
    "fundingPeriod": {
     "type": [
      "string",
      "null"
     ]
    },
    "restricted": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "restrictions": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "node": {
   "type": "object",
   "required": [
    "id",
    "type",
    "label",
    "repo",
    "evidenceStatus",
    "provenance"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^n:[a-z0-9_]+:[a-z0-9-]+$"
    },
    "type": {
     "$ref": "#/definitions/nodeType"
    },
    "label": {
     "type": "string",
     "minLength": 1
    },
    "repo": {
     "type": "string",
     "minLength": 1
    },
    "description": {
     "type": "string"
    },
    "aliases": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "evidenceStatus": {
     "$ref": "#/definitions/evidenceStatus"
    },
    "provenance": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/provenance"
     },
     "minItems": 1
    },
    "attrs": {
     "type": "object"
    },
    "notes": {
     "type": "string"
    },
    "extractedAt": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "edge": {
   "type": "object",
   "required": [
    "id",
    "source",
    "target",
    "type",
    "description",
    "repo",
    "evidenceStatus",
    "confidence",
    "provenance"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^e:[a-f0-9]{12}$"
    },
    "source": {
     "type": "string",
     "pattern": "^n:"
    },
    "target": {
     "type": "string",
     "pattern": "^n:"
    },
    "type": {
     "$ref": "#/definitions/edgeType"
    },
    "description": {
     "type": "string",
     "minLength": 1
    },
    "repo": {
     "type": "string",
     "minLength": 1
    },
    "evidenceStatus": {
     "$ref": "#/definitions/evidenceStatus"
    },
    "confidence": {
     "$ref": "#/definitions/confidence"
    },
    "provenance": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/provenance"
     },
     "minItems": 1
    },
    "temporal": {
     "$ref": "#/definitions/temporal"
    },
    "financial": {
     "$ref": "#/definitions/financial"
    },
    "flowId": {
     "type": "string",
     "pattern": "^f:"
    },
    "notes": {
     "type": "string"
    },
    "extractedAt": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "flowStage": {
   "type": "object",
   "required": [
    "from",
    "to",
    "evidenceStatus"
   ],
   "properties": {
    "from": {
     "type": "string",
     "pattern": "^n:"
    },
    "to": {
     "type": "string",
     "pattern": "^n:"
    },
    "mechanism": {
     "type": [
      "string",
      "null"
     ]
    },
    "amountUSD": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "evidenceStatus": {
     "$ref": "#/definitions/evidenceStatus"
    },
    "note": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "financialFlow": {
   "type": "object",
   "required": [
    "id",
    "label",
    "repo",
    "stages",
    "currency",
    "status",
    "evidenceStatus",
    "confidence",
    "provenance"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^f:[a-z0-9-]+$"
    },
    "label": {
     "type": "string",
     "minLength": 1
    },
    "repo": {
     "type": "string",
     "minLength": 1
    },
    "purpose": {
     "type": "string"
    },
    "stages": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/flowStage"
     },
     "minItems": 1
    },
    "amountUSD": {
     "type": [
      "number",
      "null"
     ],
     "minimum": 0
    },
    "currency": {
     "type": "string",
     "const": "USD"
    },
    "status": {
     "$ref": "#/definitions/financialStatus"
    },
    "fundingPeriod": {
     "type": [
      "string",
      "null"
     ]
    },
    "mechanism": {
     "type": [
      "string",
      "null"
     ]
    },
    "restricted": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "restrictions": {
     "type": [
      "string",
      "null"
     ]
    },
    "evidenceStatus": {
     "$ref": "#/definitions/evidenceStatus"
    },
    "confidence": {
     "$ref": "#/definitions/confidence"
    },
    "provenance": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/provenance"
     },
     "minItems": 1
    },
    "rollup": {
     "type": "object",
     "properties": {
      "originatingUSD": {
       "type": [
        "number",
        "null"
       ]
      },
      "committedUSD": {
       "type": [
        "number",
        "null"
       ]
      },
      "disbursedUSD": {
       "type": [
        "number",
        "null"
       ]
      },
      "reachingFinalUSD": {
       "type": [
        "number",
        "null"
       ]
      },
      "pctReachingFinal": {
       "type": [
        "number",
        "null"
       ]
      },
      "isEstimate": {
       "type": "boolean"
      },
      "methodology": {
       "type": "string"
      }
     },
     "additionalProperties": false
    },
    "unknowns": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "notes": {
     "type": "string"
    },
    "extractedAt": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "evidenceRecord": {
   "type": "object",
   "required": [
    "id",
    "claim",
    "status",
    "repo",
    "provenance"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^ev:[A-Z]-[0-9]+$"
    },
    "claim": {
     "type": "string",
     "minLength": 1
    },
    "status": {
     "type": "string",
     "enum": [
      "confirmed",
      "likely",
      "unverified",
      "missing",
      "risk",
      "dataset"
     ]
    },
    "source": {
     "type": [
      "string",
      "null"
     ]
    },
    "url": {
     "type": [
      "string",
      "null"
     ]
    },
    "repo": {
     "type": "string"
    },
    "provenance": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/provenance"
     },
     "minItems": 1
    },
    "notes": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "unansweredQuestion": {
   "type": "object",
   "required": [
    "id",
    "question",
    "category",
    "repo",
    "provenance"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^q:[a-z0-9-]+$"
    },
    "question": {
     "type": "string",
     "minLength": 1
    },
    "category": {
     "type": "string"
    },
    "repo": {
     "type": "string"
    },
    "relatedNodeIds": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "provenance": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/provenance"
     },
     "minItems": 1
    },
    "status": {
     "type": "string",
     "enum": [
      "open",
      "partially_answered",
      "answered"
     ]
    },
    "answer": {
     "type": "string",
     "minLength": 1
    }
   },
   "additionalProperties": false
  },
  "reviewItem": {
   "type": "object",
   "required": [
    "id",
    "itemType",
    "proposed",
    "rationale",
    "confidence",
    "decisionRequested"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^r:[a-z0-9-]+$"
    },
    "itemType": {
     "type": "string",
     "enum": [
      "node",
      "edge",
      "flow",
      "anomaly"
     ]
    },
    "proposed": {
     "type": "string"
    },
    "sourceExcerpt": {
     "type": "string"
    },
    "sourceLocation": {
     "type": "string"
    },
    "rationale": {
     "type": "string"
    },
    "confidence": {
     "$ref": "#/definitions/confidence"
    },
    "alternatives": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "decisionRequested": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 },
 "type": "object",
 "required": [
  "meta",
  "nodes",
  "edges",
  "financialFlows"
 ],
 "properties": {
  "meta": {
   "type": "object",
   "required": [
    "schemaVersion",
    "generatedAt",
    "repos"
   ],
   "properties": {
    "schemaVersion": {
     "type": "string"
    },
    "generatedAt": {
     "type": "string"
    },
    "repos": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "counts": {
     "type": "object"
    }
   }
  },
  "nodes": {
   "type": "array",
   "items": {
    "$ref": "#/definitions/node"
   }
  },
  "edges": {
   "type": "array",
   "items": {
    "$ref": "#/definitions/edge"
   }
  },
  "financialFlows": {
   "type": "array",
   "items": {
    "$ref": "#/definitions/financialFlow"
   }
  }
 }
}
