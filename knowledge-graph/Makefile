# Knowledge Graph and 3D Funding Explorer
# All targets are thin wrappers over npm scripts (see package.json).

.PHONY: install extract validate dev test build preview screenshots

install:
	npm install

extract:
	npm run extract

validate:
	npm run validate

dev:
	npm run dev

test:
	npm run test

build:
	npm run build

preview:
	npm run preview

screenshots:
	npm run screenshots
